{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jalankan Website",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\serve.ps1", "-Port", "5500"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Buka Tes Otomatis",
      "detail": "Jalankan dulu task 'Jalankan Website'. Hasil tampil di browser: Total / Lulus / Gagal.",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-Command", "Start-Process 'http://localhost:5500/tests/'"],
      "problemMatcher": [],
      "presentation": { "reveal": "never" },
      "group": "test"
    }
  ]
}
